  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The <b>MOTION SENSOR</b> must first be tuned to one of its four detection
    modes\u2014<b>ACCELEROMETER, PIR (Passive Infrared), ULTRASONIC, MICROWAVE</b>.
    Once configured, place the sensor to any vertical surface; as the summoning entity
    crosses its detection field, the device registers the disturbance and increments
    its internal counter, preserving the tally until your next inspection.\n\nKeep
    in mind that creatures may trigger more than one mode, so to uncover their resistances
    and vulnerabilities, test each setting at different points during your hunt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
