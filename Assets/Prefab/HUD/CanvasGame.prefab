  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The <b>SPIRIT TUNNER</b> iis your most crucial field instrument. Sweep
    it through every room with steady precision; as you draw near a supernatural
    echo, the device will emit a slow, rhythmic pulse that accelerates into a rapid
    stutter at close range. Once you have identified the presence of an echo, you
    can use your other tools for deeper analysis. Each echo will contain ONE testing
    profile (temperature, magnetic field, radiation or air quality).\n\nYou can also
    switch the Tuner into Recorder Mode to capture the echo\u2019s waveform\u2014this
    will provide further context of what went down in this place."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
