--- !u!114 &6284160104379798425
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 89314546192453018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The <b>BIOLOGICAL  REACTOR</b>   is the only field instrument capable
    of revealing an entity\u2019s defenses or weak points with absolute certainty.
    To operate, equip the reactor and interact with a fallen specimen\u2014this siphons
    its cellular essence into the chamber. \n\nYou must harvest cellular residue
    from at least <b>FIVE</b> different specimens before running a test. Once the
    chamber is primed, insert your chosen compound and initiate the scan. A <b><color=#FF0000>RED</color></b>
    pulse indicates the creature is fortified against that material, a <b><color=#39BFFF>BLUE</color></b>
    pulse signals a critical vulnerability, and a <b><color=#FFF100>YELLOW</color></b>
    pulse means no detectable reaction.\n\n<b>BEWARE</b>, the biological reactor
    gets easily contaminated and must be cleaned back at base, therefore you can
    only use it <b>TWO</b> times in the field. Be smart when chosing to use it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
